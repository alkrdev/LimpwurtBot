# Discord bot token, from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, from the same page as the token
CLIENT_ID=

# Optional: comma-separated guild IDs to register commands to instantly
# (e.g. "prodServerId,testServerId" to update both at once). Leave empty
# to register commands globally (can take up to ~1 hour to propagate).
GUILD_ID=

# Optional: enables new-upload announcements (see README). Get one from
# https://console.cloud.google.com/ -> enable "YouTube Data API v3" -> Credentials.
YOUTUBE_API_KEY=

# Optional: how often (in minutes) to check creators for new uploads. Default 15.
UPLOAD_POLL_INTERVAL_MINUTES=

# Optional: where persisted bot state (upload tracking, announcement channel)
# is stored on disk. Defaults to ./state. Point this at a mounted Railway
# Volume in production so it survives redeploys.
STATE_DIR=
